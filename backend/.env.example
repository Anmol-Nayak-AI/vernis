# Required
OPENAI_API_KEY=sk-your-key

# Image generation (current defaults shown)
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_FALLBACK_MODEL=gpt-image-2.5-flare
IMAGE_OUTPUT_FORMAT=webp
OPENAI_TIMEOUT_SECONDS=180

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth (server validation only; never put a service-role key in the browser)
SUPABASE_URL=https://your-project.supabase.co
AUTH_REQUIRED=false

# PostgreSQL, Redis, and private object storage
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55432/vernis
DATABASE_SCHEMA=vernis
DATABASE_ECHO=false
REDIS_URL=redis://127.0.0.1:56379/0
STORAGE_BACKEND=local
STORAGE_ROOT=storage
STORAGE_BUCKET=vernis-private
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNING_SECRET=replace-with-a-long-random-secret
UPLOAD_MAX_BYTES=52428800
UPLOAD_INTENT_TTL_SECONDS=900

# Stripe hosted Checkout (server-only)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PRICE_CREATOR=price_creator
STRIPE_PRICE_STUDIO=price_studio
STRIPE_PRICE_ARTIST=price_artist
STRIPE_PRICE_PROFESSIONAL=price_professional
STRIPE_PRICE_GALLERY=price_gallery
STRIPE_PRICE_INSTITUTION=price_institution
STRIPE_PRICE_ENTERPRISE=price_enterprise
FRONTEND_URL=http://localhost:5173

# Optional CrewAI advisory service (requires Python 3.10+)
CREW_ENABLED=false
CREW_MODEL=gpt-4o-mini
# Enables text-only external AI runs, still requiring per-run user consent.
EXTERNAL_AI_TEXT_ENABLED=false
RATE_LIMIT_PER_MINUTE=240
# Disable outbound OpenTelemetry from local agent runs. Configure an approved
# collector explicitly in production before changing this value.
OTEL_SDK_DISABLED=true
