# Required
OPENAI_API_KEY=sk-your-key

# Image generation (current defaults shown)
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_FALLBACK_MODEL=gpt-image-2.5-flare
IMAGE_OUTPUT_FORMAT=webp
OPENAI_TIMEOUT_SECONDS=180

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth (server validation only; never put a service-role key in the browser)
SUPABASE_URL=https://your-project.supabase.co
AUTH_REQUIRED=false

# Stripe hosted Checkout (server-only)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PRICE_CREATOR=price_creator
STRIPE_PRICE_STUDIO=price_studio
STRIPE_PRICE_ENTERPRISE=price_enterprise
FRONTEND_URL=http://localhost:5173

# Optional CrewAI advisory service (requires Python 3.10+)
CREW_ENABLED=false
CREW_MODEL=gpt-4o-mini
